/* user_settings.h -- wolfSSL config for ESP32 TLS 1.3 client
 *
 * Trimmed from the stock wolfSSL ESP-IDF template. Targets ONE configuration:
 *   - ESP32 (Xtensa), ESP-IDF 5.5
 *   - TLS 1.3 client only
 *   - ECC / Ed25519 / Curve25519 + RSA (for verifying an RSA cert chain)
 *   - Certs supplied as in-memory buffers (no filesystem)
 *
 * Removed: Apple HomeKit/SRP, SM2/SM3/SM4, ML-KEM/Kyber, wolfSSH, wolfMQTT,
 * PKCS#7, ATECC508A secure element, benchmark/test-suite knobs, the sample
 * certificate buffer macros, and every non-ESP32 chipset branch.
 */

#ifndef WOLFSSL_USER_SETTINGS_H
#define WOLFSSL_USER_SETTINGS_H

#include "sdkconfig.h"

/* ---------------------------------------------------------------------------
 * Platform
 * ------------------------------------------------------------------------ */
#define WOLFSSL_ESPIDF
#define WOLFSSL_ESP32

#if !defined(CONFIG_IDF_TARGET_ESP32)
#error "This user_settings.h is trimmed for CONFIG_IDF_TARGET_ESP32 only."
#endif

/* Long crypto ops can trip the task watchdog. */
#define WOLFSSL_ESP_NO_WATCHDOG 1

/* wolfSSL is used from a single task (app_main). Drop this if you ever call
 * wolfSSL from more than one task. */
#define SINGLE_THREADED

/* ---------------------------------------------------------------------------
 * Math backend
 *
 * TFM needs FP_MAX_BITS >= 2x the largest modulus, because multiplying two
 * n-digit numbers needs 2n digits of scratch. The RSA-4096 CA in our chain
 * therefore requires 8192. Leaving this undefined silently yields TFM's
 * default of 4096, which fails CA verification with MP_EXPTMOD_E ->
 * ASN_SIG_CONFIRM_E (-155) and a bad_certificate alert.
 *
 * The auto-fallback in settings.h that would otherwise set 8192 is gated on
 * WOLFSSL_X86_64_BUILD / WOLFSSL_AARCH64_BUILD / OPENSSL_EXTRA, none of which
 * apply on Xtensa -- so it must be set explicitly here.
 * ------------------------------------------------------------------------ */
#define USE_FAST_MATH
#define FP_MAX_BITS (4096 * 2)

/* Smaller RSA footprint: about half the memory, roughly twice as slow. */
#define RSA_LOW_MEM

/* Big ints on the heap instead of the stack. Keeps the 10.5 KB main task
 * stack viable now that FP_MAX_BITS is doubled. */
#define WOLFSSL_SMALL_STACK

/* ---------------------------------------------------------------------------
 * TLS 1.3
 * ------------------------------------------------------------------------ */
#define WOLFSSL_TLS13
#define HAVE_TLS_EXTENSIONS
#define HAVE_HKDF /* required by TLS 1.3 key schedule */
#define HAVE_SUPPORTED_CURVES
#define HAVE_AEAD
#define HAVE_AESGCM
#define WC_RSA_PSS /* TLS 1.3 CertificateVerify forbids PKCS#1 v1.5 */

#define NO_OLD_TLS /* no SSLv3 / TLS 1.0 / 1.1 */

#if !defined(CONFIG_WOLFSSL_ALLOW_TLS12)
#define WOLFSSL_NO_TLS12 /* matches menuconfig: TLS 1.2 not enabled */
#endif

/* Needed only when connecting to a host that serves multiple sites per IP
 * (CDNs). Harmless otherwise; costs very little. */
#define HAVE_SNI

/* FFDHE-2048 as a fallback group. TLS 1.3 works fine with ECC groups alone,
 * so this can be removed if you only ever negotiate ECDHE. Do NOT raise it to
 * FFDHE-4096 without also raising FP_MAX_BITS -- settings.h will #error. */
#define HAVE_FFDHE_2048

/* Certs come from ca_cert.h as buffers. */
#define NO_FILESYSTEM

/* Saves roughly 5-20 KB of RAM. Also disables session tickets. */
#define NO_SESSION_CACHE

/* Newer, smaller ASN.1 parser. */
#define WOLFSSL_ASN_TEMPLATE

/* ---------------------------------------------------------------------------
 * Algorithms
 * ------------------------------------------------------------------------ */
#define WOLFSSL_AES

#define WOLFSSL_SHA384 /* TLS_AES_256_GCM_SHA384 */
#define WOLFSSL_SHA512 /* required by Ed25519 */

#define HAVE_ECC
#define HAVE_CURVE25519
#define HAVE_ED25519

/* RSA stays enabled (wolfSSL default) -- the server cert chain is RSA.
 * Define NO_RSA here only if you move the whole chain to ECDSA. */

/* ---------------------------------------------------------------------------
 * ESP32 hardware acceleration
 *
 * Enabled by default. Uncomment a line to force the software path if you
 * suspect a hardware bug.
 * ------------------------------------------------------------------------ */
/* #define NO_ESP32_CRYPT                          */
/* #define NO_WOLFSSL_ESP32_CRYPT_HASH             */
/* #define NO_WOLFSSL_ESP32_CRYPT_AES              */
/* #define NO_WOLFSSL_ESP32_CRYPT_RSA_PRI          */
/* #define NO_WOLFSSL_ESP32_CRYPT_RSA_PRI_MP_MUL   */
/* #define NO_WOLFSSL_ESP32_CRYPT_RSA_PRI_MULMOD   */
/* #define NO_WOLFSSL_ESP32_CRYPT_RSA_PRI_EXPTMOD  */

/* No SHA-224 accelerator on the ESP32; falls back to software. */
#define NO_WOLFSSL_ESP32_CRYPT_HASH_SHA224

#ifndef NO_RSA
#define ESP32_USE_RSA_PRIMITIVE

/* The ESP32 MPI accelerator is unreliable below these operand sizes, so
 * small operations are routed to software. */
#define ESP_RSA_EXPT_XBITS 32
#define ESP_RSA_MULM_BITS 16

/* Poll limit while waiting on the MPI peripheral. */
#ifndef ESP_RSA_TIMEOUT_CNT
#define ESP_RSA_TIMEOUT_CNT 0xFF0000
#endif
#endif

/* ---------------------------------------------------------------------------
 * Debug
 * ------------------------------------------------------------------------ */
#define DEBUG_WOLFSSL /* enables wolfSSL_Debugging_ON(); very verbose */
#define WOLFSSL_MAX_ERROR_SZ 500
/* #define DEBUG_WOLFSSL_MALLOC     */

/* ---------------------------------------------------------------------------
 * Optional hardening (slower, uncomment if the threat model warrants it)
 * ------------------------------------------------------------------------ */
/* #define TFM_TIMING_RESISTANT */
/* #define WC_RSA_BLINDING      */

/* ---------------------------------------------------------------------------
 * Compile-time sanity checks
 * ------------------------------------------------------------------------ */
#if defined(CONFIG_ESP_MAIN_TASK_STACK_SIZE) &&                                \
    (CONFIG_ESP_MAIN_TASK_STACK_SIZE < 10500)
#warning "RSA on ESP32 wants at least ~10.5 KB of main task stack."
#endif

#if FP_MAX_BITS < 8192
#error "FP_MAX_BITS must be >= 8192 to verify the RSA-4096 CA in our chain."
#endif

#endif /* WOLFSSL_USER_SETTINGS_H */
